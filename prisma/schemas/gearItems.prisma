model GearItem {
  id          String   @id @default(uuid())
  title       String
  description String
  pricePerDay Float
  brand       String
  stock       Int      @default(1)
  isAvailable Boolean  @default(true)
  images      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Foreign Keys
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  providerId String
  provider   User   @relation("ProviderGears", fields: [providerId], references: [id], onDelete: Cascade)

  // Relations
  rentalOrders RentalOrder[]
  reviews      Review[]

  @@map("gear_items")
}